# Copie para .env e preencha. O .env não é versionado.

# Conexão com o Postgres do cultural-events-app, com a role agent_writer.
DATABASE_URL=postgresql://agent_writer:troque-a-senha@localhost:5432/cultural_events

# Chave da API da Anthropic.
ANTHROPIC_API_KEY=troque-pela-sua-chave

# Modelo do Claude (padrão: claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Identifica o agente para as fontes; inclua um contato.
USER_AGENT=cultural-events-agent/0.1 (contato@example.com)

# Pausa entre requisições, em segundos (padrão: 2).
REQUEST_DELAY_SECONDS=2

# Só os testes de banco leem esta variável: pasta com as migrations .sql do cultural-events-app.
MIGRATIONS_DIR=../cultural-events-app/database/migrations
